DATABASE_URL=postgresql+psycopg://tunnelsight:tunnelsight@localhost:5432/tunnelsight
SESSION_SECRET=change-me-to-32-plus-random-chars-minimum
SESSION_COOKIE_NAME=ts_session
SESSION_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000

# Groq AI explanation layer. Leave GROQ_API_KEY empty to disable the
# AI routes (they answer 503 and the deterministic findings still work).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_TOKENS=2000
