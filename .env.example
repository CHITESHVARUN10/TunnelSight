# Root env pointer — copy relevant bits into backend/.env and frontend/.env.local
# Backend DB (local Postgres, no Docker for Phase 0)
# Later NeonDB: just swap this URL, no code change.
DATABASE_URL=postgresql+psycopg://tunnelsight:tunnelsight@localhost:5432/tunnelsight
SESSION_SECRET=change-me-to-32-plus-random-chars
SESSION_COOKIE_NAME=ts_session
SESSION_EXPIRE_DAYS=7

# AI explanation layer (OpenRouter). Leave the key empty to disable the AI routes.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1:free

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
